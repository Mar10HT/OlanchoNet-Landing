---
const plans = [
  {
    name: '100 Megas + TV',
    mbps: 100,
    price: '650',
    popular: true,
    features: [
      'Internet fibra óptica 100 Mbps',
      'Televisión por cable incluida',
      'Instalación incluida',
      'Soporte técnico local',
    ],
  },
  {
    name: '200 Megas',
    mbps: 200,
    price: '900',
    popular: false,
    features: [
      'Internet fibra óptica 200 Mbps',
      'Ideal para gaming y streaming 4K',
      'Instalación incluida',
      'Soporte técnico local',
    ],
  },
];
---

<section id="planes" class="py-24 lg:py-32" style="background: var(--color-brand-darker);">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">

    <!-- Header -->
    <div class="reveal flex flex-col items-center text-center mb-12 gap-4">
      <span
        class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-bold tracking-widest uppercase"
        style="background: rgba(78,182,72,0.12); color: var(--color-brand-green);"
      >
        Nuestros planes
      </span>
      <h2 class="font-display font-black text-4xl lg:text-5xl text-white tracking-tight">
        Internet para todos
      </h2>
      <p class="text-white/50 text-sm max-w-md leading-relaxed">
        Fibra óptica con instalación incluida y soporte técnico local. Sin contratos de permanencia.
      </p>
    </div>

    <!-- Cards grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-stretch">

      <!-- Plan cards -->
      {plans.map((plan) => (
        <div
          class="reveal rounded-2xl flex flex-col p-7"
          style={plan.popular
            ? 'background: #081628; box-shadow: inset 0 0 0 2px var(--color-brand-blue);'
            : 'background: #0D1421; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.07);'}
        >
          <div class="flex items-center justify-between mb-6">
            <span class="text-[11px] font-bold tracking-[0.15em] text-white/50 uppercase">{plan.name}</span>
            {plan.popular && (
              <span
                class="text-[10px] font-bold px-2 py-0.5 rounded-full"
                style="background: rgba(78,182,72,0.18); color: var(--color-brand-green);"
              >
                Más popular
              </span>
            )}
          </div>

          <div class="flex items-baseline gap-1.5">
            <span class="font-display font-black text-6xl leading-none text-white select-none">{plan.mbps}</span>
            <span class="text-sm tracking-[0.2em] text-white/35 uppercase">Mbps</span>
          </div>
          <div class="mt-2 mb-6">
            <span class="font-display font-bold text-2xl text-white">L {plan.price}</span>
            <span class="text-sm text-white/50">/mes</span>
          </div>

          <ul class="flex flex-col gap-2.5 mb-6 flex-1">
            {plan.features.map((f) => (
              <li class="flex items-center gap-2 text-[13px] text-white/75">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true" class="shrink-0">
                  <circle cx="7" cy="7" r="7" fill="rgba(78,182,72,0.2)"/>
                  <path d="M4 7l2 2 4-4" stroke="var(--color-brand-green)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                {f}
              </li>
            ))}
          </ul>

          <a
            href="#contacto"
            class="flex items-center justify-center h-11 rounded-lg text-[13px] font-bold text-white transition-opacity hover:opacity-90"
            style="background: var(--color-brand-blue);"
          >
            Contáctanos
          </a>
        </div>
      ))}

      <!-- CTA: more speed -->
      <div class="reveal rounded-2xl flex flex-col p-7" style="background: #0D1421; box-shadow: inset 0 0 0 1px rgba(255,255,255,0.07);">
        <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-5" style="background: rgba(0,118,187,0.15);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/>
          </svg>
        </div>
        <h3 class="font-display font-bold text-xl text-white mb-2">¿Necesitas más velocidad?</h3>
        <p class="text-white/50 text-sm leading-relaxed flex-1">
          Tenemos planes de mayor capacidad. Contáctanos y armamos el plan ideal para ti.
        </p>
        <a
          href="#contacto"
          class="flex items-center justify-center h-11 rounded-lg text-[13px] font-bold text-white mt-6 border border-white/20 transition-colors hover:bg-white/5"
        >
          Contáctanos
        </a>
      </div>

      <!-- CTA: business -->
      <div class="reveal rounded-2xl flex flex-col p-7" style="background: linear-gradient(160deg, rgba(0,118,187,0.16), #0D1421);">
        <div class="w-11 h-11 rounded-xl flex items-center justify-center mb-5" style="background: rgba(0,118,187,0.22);">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-brand-blue)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
            <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
          </svg>
        </div>
        <h3 class="font-display font-bold text-xl text-white mb-2">¿Soluciones para tu empresa?</h3>
        <p class="text-white/50 text-sm leading-relaxed flex-1">
          Fibra empresarial con ancho de banda simétrico, IP fija y atención prioritaria. Hablemos de tu proyecto.
        </p>
        <a
          href="#contacto"
          class="flex items-center justify-center h-11 rounded-lg text-[13px] font-bold text-white mt-6 transition-opacity hover:opacity-90"
          style="background: var(--color-brand-blue);"
        >
          Contáctanos
        </a>
      </div>

    </div>
  </div>
</section>
